         a smoke-test build can redirect the next Word launch to bin\Debug, and a
         clean can unregister the product entirely. Development registration is
         therefore explicit through scripts\Register-LaTeXBlocks.ps1. Set this
         property to true only when the standard VSTO target behavior is wanted. -->
    <EnableVstoProjectRegistration Condition="'$(EnableVstoProjectRegistration)' == ''">false</EnableVstoProjectRegistration>
  </PropertyGroup>
  <!-- These later definitions intentionally override the targets imported above. -->
  <Target Name="RegisterOfficeAddin"
